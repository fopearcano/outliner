#!/bin/bash
# ---------------------------------------------------------------------------
# Outliner.app launcher.
#
# Serves the built app locally and opens it in your browser (where you can then
# "Install Outliner" as a real PWA app). Plain shell-script bundle — no compile,
# no code signing; runs on Apple Silicon and Intel.
#
# Make it self-contained & movable anywhere (incl. /Applications) by running,
# once, in the project folder:   npm run mac
# That copies the built site into this bundle's Resources.
# ---------------------------------------------------------------------------
set -uo pipefail

LOG="${TMPDIR:-/tmp}/outliner-launcher.log"
exec >>"$LOG" 2>&1
echo "=== launch $(date) ==="

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"          # .../Contents/MacOS
RES="$(cd "$SELF_DIR/.." 2>/dev/null && pwd)/Resources"
PORT=5273
URL="http://localhost:$PORT"

note() { osascript -e "display notification \"$1\" with title \"Outliner\"" >/dev/null 2>&1 || true; }
errorbox() {
  osascript -e "display dialog \"$1\" with title \"Outliner\" buttons {\"OK\"} default button 1 with icon caution" >/dev/null 2>&1 || true
}

# Prefer a self-contained copy bundled inside the .app; otherwise fall back to
# the project folder this .app lives in (works when kept inside the repo).
if [ -f "$RES/dist/index.html" ] && [ -f "$RES/serve.mjs" ]; then
  DIST="$RES/dist"; SERVE="$RES/serve.mjs"
else
  REPO="$(cd "$SELF_DIR/../../.." 2>/dev/null && pwd)"
  DIST="$REPO/dist"; SERVE="$REPO/scripts/serve.mjs"
fi
echo "DIST=$DIST"
echo "SERVE=$SERVE"

if [ ! -f "$DIST/index.html" ] || [ ! -f "$SERVE" ]; then
  errorbox "Outliner isn't set up here yet. In the project folder run:  npm run mac  — then move/relaunch this app. (Checked: $DIST — see log: $LOG)"
  exit 1
fi

find_node() {
  local c d p
  for c in /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node; do
    [ -x "$c" ] && { echo "$c"; return 0; }
  done
  for d in "$HOME"/.nvm/versions/node/*/bin "$HOME/.volta/bin" "$HOME"/.fnm/*/installation/bin "$HOME/.asdf/shims"; do
    [ -x "$d/node" ] && { echo "$d/node"; return 0; }
  done
  # Fall back to the login shell's PATH (covers nvm/fnm/asdf/volta shims).
  p="$("${SHELL:-/bin/zsh}" -lic 'command -v node' 2>/dev/null | tail -n1)"
  [ -n "${p:-}" ] && [ -x "$p" ] && { echo "$p"; return 0; }
  return 1
}

NODE="$(find_node || true)"
if [ -z "${NODE:-}" ]; then
  errorbox "Couldn't find Node.js. Install it from https://nodejs.org (or 'brew install node'), then open Outliner again."
  exit 1
fi
echo "NODE=$NODE"

# Is the CORRECT Outliner app already answering on this port? We check for our
# actual page — not just "something responded" — so a stale server left serving
# the wrong folder (which returns 404s) doesn't get mistaken for a live app.
server_ok() { curl -s --max-time 2 "$URL/" 2>/dev/null | grep -q 'id="root"'; }

if ! server_ok; then
  # Replace any stale Outliner server we previously left on this port, then
  # serve the correct built site. (Our background servers only run serve.mjs.)
  pkill -f "serve.mjs.*${PORT}" 2>/dev/null || true
  nohup "$NODE" "$SERVE" "$DIST" "$PORT" >>"$LOG" 2>&1 &
fi

# Wait (up to ~12s) for the correct server to come up and serve our page.
ready=0
for _ in $(seq 1 60); do
  if server_ok; then ready=1; break; fi
  sleep 0.2
done
if [ "$ready" != 1 ]; then
  errorbox "Outliner's local server didn't start correctly. Quit any stale copy with:  pkill -f serve.mjs  — then relaunch. Details: $LOG"
  exit 1
fi

# Open in a Chromium browser (a normal window, so the address-bar "Install
# Outliner" button is available), else the default browser.
open_browser() {
  local app
  for app in "Google Chrome" "Microsoft Edge" "Brave Browser" "Chromium" "Vivaldi"; do
    if [ -d "/Applications/$app.app" ] || [ -d "$HOME/Applications/$app.app" ]; then
      open -a "$app" "$URL" >/dev/null 2>&1 && return 0
    fi
  done
  open "$URL"
}
open_browser
echo "opened $URL"
exit 0
